# Normalize line endings so tooling (e.g. gofmt on Windows) agrees across
# platforms. Text files are stored as LF in the repo and checked out as LF.
* text=auto eol=lf

# Windows scripts must keep CRLF or cmd.exe can misbehave.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch line endings.
*.png binary
*.ico binary
*.icns binary
*.svg binary
*.woff binary
*.woff2 binary
